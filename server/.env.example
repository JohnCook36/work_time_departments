PORT=3000
# Exact browser origin only (scheme + host + optional port, no path).
# Required when NODE_ENV=production.
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://work_time_departments:change-me-local@localhost:5433/work_time_departments?schema=public

POSTGRES_DB=work_time_departments
POSTGRES_USER=work_time_departments
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5433

# Development-only phone authentication.
# Dev OTP is disabled unless explicitly opted in.
AUTH_ALLOW_DEV_OTP=true
# Never enable dev OTP or use AUTH_DEV_OTP_CODE in production.
AUTH_DEV_OTP_CODE=123456
# Generate a unique random value of at least 32 characters for each environment.
AUTH_OTP_PEPPER=replace-with-a-long-random-secret-at-least-32-chars

# OTP abuse protection.
# By default, only the direct TCP peer is trusted as the request source.
# Set this to the exact number of trusted reverse-proxy hops only when deployment topology is known.
AUTH_TRUST_PROXY_HOPS=0
# Successful OTP sends allowed per hashed request source inside the rolling window.
AUTH_OTP_SOURCE_WINDOW_SECONDS=600
AUTH_OTP_SOURCE_MAX_REQUESTS=20

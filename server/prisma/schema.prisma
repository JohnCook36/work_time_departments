generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DepartmentKind {
  GENERAL
  FO
  NIGHT
}

enum RoleType {
  SUPER_ADMIN
  DEPARTMENT_ADMIN
  DEPUTY
  EMPLOYEE
}

model Department {
  id        String         @id @default(cuid())
  name      String
  kind      DepartmentKind @default(GENERAL)
  position  Int            @default(0)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  employees   Employee[]
  memberships Membership[]
}

model User {
  id          String       @id @default(cuid())
  phoneE164   String       @unique @db.VarChar(32)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  employee    Employee?
  memberships Membership[]
}

model Employee {
  id             String         @id @default(cuid())
  displayName    String
  employmentRate Float          @default(1)
  departmentId   String
  userId         String?        @unique
  position       Int            @default(0)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  shifts         Shift[]
  wishes         EmployeeWish[]

  @@index([departmentId])
}

model Membership {
  id           String     @id @default(cuid())
  userId       String
  departmentId String?
  role         RoleType
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([departmentId])
  @@index([role])
}

model Schedule {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shifts    Shift[]

  @@unique([year, month])
}

model Shift {
  id         String   @id @default(cuid())
  scheduleId String
  employeeId String
  date       DateTime @db.Date
  code       String?  @db.VarChar(16)
  startTime  String?  @db.VarChar(5)
  endTime    String?  @db.VarChar(5)
  isOff      Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, employeeId, date])
  @@index([employeeId])
  @@index([scheduleId])
}

model EmployeeWish {
  id         String   @id @default(cuid())
  employeeId String
  year       Int
  month      Int
  day        Int?
  text       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DepartmentKind {
  GENERAL
  FO
  NIGHT
}

enum RoleType {
  SUPER_ADMIN
  DEPARTMENT_ADMIN
  DEPUTY
  EMPLOYEE
}

enum PermissionCapability {
  SCHEDULE_READ
  SCHEDULE_EDIT
  SCHEDULE_PUBLISH
  EMPLOYEE_MANAGE
  ONBOARDING_REVIEW
  SHIFT_CHANGE_APPROVE
  SCHEDULE_RULE_MANAGE
  AUDIT_READ
  PRIVATE_PROFILE_READ
  PRIVATE_PROFILE_EDIT
  ROLE_MANAGE
}

enum ScheduleRuleScope {
  ORGANIZATION
  DEPARTMENT
  ROLE
  SHIFT_TYPE
}

enum ScheduleRuleSeverity {
  HARD
  SOFT
}

enum ScheduleRuleKind {
  MAX_CONCURRENT_EMPLOYEES
  MIN_STAFF_AT_TIME
}

enum EmployeeScheduleMode {
  FLEXIBLE
  FIXED_WEEKDAYS
}

enum OnboardingRequestType {
  LINK_EXISTING
  CREATE_EMPLOYEE
}

enum OnboardingRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum ShiftChangeRequestKind {
  SWAP
  COVER
}

enum ShiftChangeRequestStatus {
  PENDING_TARGET
  PENDING_MANAGER
  TARGET_REJECTED
  MANAGER_APPROVED
  MANAGER_REJECTED
  CANCELED
  STALE
}

enum ShiftChangeRequestEventType {
  CREATED
  TARGET_ACCEPTED
  TARGET_REJECTED
  CANCELED
  MANAGER_APPROVED
  MANAGER_REJECTED
  MARKED_STALE
}

enum AuditAction {
  EMPLOYEE_DEACTIVATED
  DEPARTMENT_DEACTIVATED
  SCHEDULE_CHANGED
  SCHEDULE_PUBLISHED
  SCHEDULE_RULE_CREATED
  SCHEDULE_RULE_UPDATED
  SCHEDULE_RULE_DELETED
  ONBOARDING_APPROVED
  ONBOARDING_REJECTED
  SHIFT_CHANGE_MANAGER_APPROVED
  SHIFT_CHANGE_MANAGER_REJECTED
  ROLE_ASSIGNMENT_CREATED
  ROLE_PERMISSIONS_UPDATED
  ROLE_ASSIGNMENT_DEACTIVATED
}

enum AuditEntityType {
  EMPLOYEE
  DEPARTMENT
  SCHEDULE
  SCHEDULE_RULE
  ONBOARDING_REQUEST
  SHIFT_CHANGE_REQUEST
  MEMBERSHIP
}

enum NotificationCategory {
  SHIFT_CHANGE
  SCHEDULE_PUBLICATION
  TASK
  SCHEDULE_RULE
  SYSTEM
}

enum NotificationEntityType {
  SHIFT_CHANGE_REQUEST
  SCHEDULE_PUBLICATION
  TASK
  SCHEDULE_RULE
  SYSTEM
}

model Department {
  id        String         @id @default(cuid())
  name      String
  kind      DepartmentKind @default(GENERAL)
  position  Int            @default(0)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  employees             Employee[]
  memberships           Membership[]
  onboardingRequests    OnboardingRequest[]
  requestedShiftChanges ShiftChangeRequest[] @relation("ShiftChangeRequesterDepartment")
  targetedShiftChanges  ShiftChangeRequest[] @relation("ShiftChangeTargetDepartment")
  schedulePublications   SchedulePublication[]
  scheduleRules          ScheduleRule[]
}

model User {
  id          String       @id @default(cuid())
  phoneE164   String       @unique @db.VarChar(32)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  employee                   Employee?
  memberships                Membership[]
  sessions                   AuthSession[]
  onboardingRequests         OnboardingRequest[]       @relation("OnboardingRequester")
  reviewedOnboardingRequests OnboardingRequest[]       @relation("OnboardingReviewer")
  requestedShiftChanges      ShiftChangeRequest[]      @relation("ShiftChangeRequesterUser")
  targetedShiftChanges       ShiftChangeRequest[]      @relation("ShiftChangeTargetUser")
  managedShiftChanges        ShiftChangeRequest[]      @relation("ShiftChangeManagerUser")
  shiftChangeEvents          ShiftChangeRequestEvent[] @relation("ShiftChangeEventActor")
  schedulePublications       SchedulePublication[]
  createdScheduleRules       ScheduleRule[]        @relation("ScheduleRuleCreatedBy")
  updatedScheduleRules       ScheduleRule[]        @relation("ScheduleRuleUpdatedBy")
  scheduleRuleVersions       ScheduleRuleVersion[] @relation("ScheduleRuleVersionChangedBy")
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  scheduleAcknowledgements    ScheduleAcknowledgement[]
}

model Employee {
  id             String         @id @default(cuid())
  displayName    String
  employmentRate Float          @default(1)
  scheduleMode   EmployeeScheduleMode @default(FLEXIBLE)
  fixedStartTime String?         @db.VarChar(5)
  fixedEndTime   String?         @db.VarChar(5)
  departmentId   String
  userId         String?        @unique
  position       Int            @default(0)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  shifts                Shift[]
  wishes                EmployeeWish[]
  linkRequests          OnboardingRequest[]
  requestedShiftChanges ShiftChangeRequest[] @relation("ShiftChangeRequesterEmployee")
  targetedShiftChanges  ShiftChangeRequest[] @relation("ShiftChangeTargetEmployee")
  scheduleAcknowledgements ScheduleAcknowledgement[]

  @@index([departmentId])
}

model Membership {
  id           String     @id @default(cuid())
  userId       String
  departmentId String?
  role         RoleType
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  permissions  MembershipPermission[]

  @@index([userId])
  @@index([departmentId])
  @@index([role])
}

model MembershipPermission {
  id           String               @id @default(cuid())
  membershipId String
  capability   PermissionCapability
  createdAt    DateTime             @default(now())
  membership   Membership           @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, capability])
  @@index([capability])
}

model Schedule {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shifts       Shift[]
  publications SchedulePublication[]

  @@unique([year, month])
}

model Shift {
  id         String   @id @default(cuid())
  scheduleId String
  employeeId String
  date       DateTime @db.Date
  code       String?  @db.VarChar(16)
  startTime  String?  @db.VarChar(5)
  endTime    String?  @db.VarChar(5)
  isOff      Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  schedule              Schedule             @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employee              Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  requestedShiftChanges ShiftChangeRequest[] @relation("ShiftChangeRequesterShift")
  targetedShiftChanges  ShiftChangeRequest[] @relation("ShiftChangeTargetShift")

  @@unique([scheduleId, employeeId, date])
  @@index([employeeId])
  @@index([scheduleId])
}

model EmployeeWish {
  id         String   @id @default(cuid())
  employeeId String
  year       Int
  month      Int
  day        Int?
  text       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
}


model AuthChallenge {
  id                String    @id @default(cuid())
  phoneE164         String    @db.VarChar(32)
  codeHash          String    @db.VarChar(64)
  requestSourceHash String?   @db.VarChar(64)
  expiresAt         DateTime
  attempts          Int       @default(0)
  maxAttempts       Int       @default(5)
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([phoneE164, createdAt])
  @@index([requestSourceHash, createdAt])
  @@index([expiresAt])
}

model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}


model OnboardingRequest {
  id                   String                  @id @default(cuid())
  userId               String
  type                 OnboardingRequestType
  status               OnboardingRequestStatus @default(PENDING)
  departmentId         String
  employeeId           String?
  requestedDisplayName String?
  reviewedByUserId     String?
  reviewedAt           DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  user                 User                    @relation("OnboardingRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy           User?                   @relation("OnboardingReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  department           Department              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  employee             Employee?               @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([departmentId, status])
  @@index([employeeId])
  @@index([reviewedByUserId])
}

model ShiftChangeRequest {
  id                      String                   @id @default(cuid())
  kind                    ShiftChangeRequestKind
  status                  ShiftChangeRequestStatus @default(PENDING_TARGET)
  requesterUserId         String
  requesterEmployeeId     String
  requesterDepartmentId   String
  targetUserId            String
  targetEmployeeId        String
  targetDepartmentId      String
  requesterShiftId        String
  targetShiftId           String?
  requesterShiftUpdatedAt DateTime
  targetShiftUpdatedAt    DateTime?
  managerUserId           String?
  resolvedAt              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  requesterUser           User                     @relation("ShiftChangeRequesterUser", fields: [requesterUserId], references: [id], onDelete: Restrict)
  requesterEmployee       Employee                 @relation("ShiftChangeRequesterEmployee", fields: [requesterEmployeeId], references: [id], onDelete: Restrict)
  requesterDepartment     Department               @relation("ShiftChangeRequesterDepartment", fields: [requesterDepartmentId], references: [id], onDelete: Restrict)
  targetUser              User                     @relation("ShiftChangeTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  targetEmployee          Employee                 @relation("ShiftChangeTargetEmployee", fields: [targetEmployeeId], references: [id], onDelete: Restrict)
  targetDepartment        Department               @relation("ShiftChangeTargetDepartment", fields: [targetDepartmentId], references: [id], onDelete: Restrict)
  requesterShift          Shift                    @relation("ShiftChangeRequesterShift", fields: [requesterShiftId], references: [id], onDelete: Restrict)
  targetShift             Shift?                   @relation("ShiftChangeTargetShift", fields: [targetShiftId], references: [id], onDelete: Restrict)
  managerUser             User?                    @relation("ShiftChangeManagerUser", fields: [managerUserId], references: [id], onDelete: Restrict)
  events                  ShiftChangeRequestEvent[]

  @@index([requesterUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([status, createdAt])
  @@index([requesterDepartmentId, status])
  @@index([targetDepartmentId, status])
  @@index([requesterShiftId])
  @@index([targetShiftId])
  @@index([managerUserId])
}

model ShiftChangeRequestEvent {
  id          String                      @id @default(cuid())
  requestId   String
  eventType   ShiftChangeRequestEventType
  actorUserId String
  metadata    Json?
  createdAt   DateTime                    @default(now())
  request     ShiftChangeRequest          @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actorUser   User                        @relation("ShiftChangeEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([actorUserId])
  @@index([eventType])
}


model SchedulePublication {
  id                      String   @id @default(cuid())
  scheduleId              String
  departmentId            String
  version                 Int
  publishedByUserId       String
  sourceScheduleUpdatedAt DateTime
  comment                 String?  @db.VarChar(500)
  rulesVersion            String?  @db.VarChar(100)
  rulesSnapshot           Json?
  snapshot                Json
  diff                    Json
  createdAt               DateTime @default(now())
  schedule                Schedule   @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  department              Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  publishedBy             User       @relation(fields: [publishedByUserId], references: [id], onDelete: Restrict)
  acknowledgements        ScheduleAcknowledgement[]

  @@unique([scheduleId, departmentId, version])
  @@index([scheduleId, departmentId, createdAt])
  @@index([publishedByUserId, createdAt])
}

model ScheduleRule {
  id                String               @id @default(cuid())
  name              String               @db.VarChar(120)
  description       String               @db.Text
  kind              ScheduleRuleKind
  scope             ScheduleRuleScope
  scopeValue        String?              @db.VarChar(64)
  departmentId      String?
  priority          Int                  @default(100)
  severity          ScheduleRuleSeverity @default(HARD)
  isActive          Boolean              @default(true)
  isDeleted         Boolean              @default(false)
  config            Json
  violationMessage  String               @db.VarChar(500)
  version           Int                  @default(1)
  createdByUserId   String
  updatedByUserId   String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  department        Department?          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy         User                 @relation("ScheduleRuleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy         User                 @relation("ScheduleRuleUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  versions          ScheduleRuleVersion[]

  @@index([scope, isActive, isDeleted])
  @@index([departmentId, isActive, isDeleted])
  @@index([kind, isActive, isDeleted])
  @@index([priority])
}

model ScheduleRuleVersion {
  id              String       @id @default(cuid())
  ruleId          String
  version         Int
  snapshot        Json
  changedByUserId String
  createdAt       DateTime     @default(now())
  rule            ScheduleRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  changedBy       User         @relation("ScheduleRuleVersionChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@unique([ruleId, version])
  @@index([ruleId, createdAt])
  @@index([changedByUserId, createdAt])
}

model AuditLog {
  id           String          @id @default(cuid())
  actorUserId  String
  action       AuditAction
  entityType   AuditEntityType
  entityId     String
  departmentId String?
  createdAt    DateTime        @default(now())

  @@index([actorUserId, createdAt])
  @@index([departmentId, createdAt])
  @@index([action, createdAt])
}


model Notification {
  id          String                 @id @default(cuid())
  recipientId String
  category    NotificationCategory
  entityType  NotificationEntityType
  entityId    String?
  eventKey    String                 @db.VarChar(180)
  critical    Boolean                @default(false)
  readAt      DateTime?
  createdAt   DateTime               @default(now())
  recipient   User                   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, eventKey])
  @@index([recipientId, readAt, createdAt])
  @@index([category, createdAt])
}

model NotificationPreference {
  id        String               @id @default(cuid())
  userId    String
  category  NotificationCategory
  enabled   Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}


model ScheduleAcknowledgement {
  id             String              @id @default(cuid())
  publicationId  String
  employeeId     String
  acknowledgedByUserId String
  acknowledgedAt DateTime            @default(now())
  publication    SchedulePublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  employee       Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  acknowledgedBy User                @relation(fields: [acknowledgedByUserId], references: [id], onDelete: Restrict)

  @@unique([publicationId, employeeId])
  @@index([publicationId, acknowledgedAt])
  @@index([employeeId, acknowledgedAt])
  @@index([acknowledgedByUserId, acknowledgedAt])
}
